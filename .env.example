# demo | live
APP_MODE=demo
BETTER_AUTH_SECRET=
# Neon. Leave empty to use the embedded local database in ./.data
DATABASE_URL=
# Stripe (test keys in demos). Leave empty for the simulated demo checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_ACCOUNT_ID=
PLATFORM_FEE_BPS=0
RESEND_API_KEY=
RETELL_API_KEY=
# Comma-separated emails that get webmaster access on every client site
WEBMASTER_EMAILS=
# Set at launch (docs/13-accounts-roles.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Delivery drivers (docs/17-delivery-and-order-alerts.md). Demo sites use a pretend driver without these.
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=
UBER_CUSTOMER_ID=
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
# Phone notifications (Web Push). Optional: generated and kept in the database when empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
