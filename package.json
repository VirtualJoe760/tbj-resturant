{
  "name": "restaurant-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "seed:check": "tsx src/db/seed.ts --dry-run",
    "import-client": "tsx --tsconfig tsconfig.json scripts/import-client.ts",
    "create-restaurant": "node packages/create-restaurant/bin.mjs",
    "vercel-build": "tsx --tsconfig tsconfig.json scripts/setup-db.ts && next build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.8",
    "@neondatabase/serverless": "1.0.1",
    "better-auth": "1.3.27",
    "drizzle-orm": "0.44.5",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "0.0.1",
    "stripe": "18.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "tsx": "4.20.5",
    "typescript": "^5",
    "vitest": "3.2.4"
  }
}
