{
  "name": "create-tbj-resturant",
  "version": "0.2.0",
  "description": "Create a TBJ restaurant app: npx create-tbj-resturant. Asks about the restaurant (Google, Yelp, website or manual), menu, menu times, logo, app icon, photos, fonts, colors and delivery, and sets up the whole site.",
  "type": "module",
  "bin": {
    "create-tbj-resturant": "dist/cli.mjs"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/cli.mjs \"--banner:js=#!/usr/bin/env node\"",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@clack/prompts": "0.11.0",
    "tsx": "4.20.5",
    "zod": "3.25.76"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VirtualJoe760/tbj-resturant.git",
    "directory": "packages/create-tbj-restaurant"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
